# Default-deny policy: only the public-source allowlist below is tracked.
# Local secrets, runtime data, tests, and development artifacts remain ignored
# unless they are deliberately added to the allowlist.
*

# Git metadata and public entry points
!.gitignore
!README.md
!app.py
!requirements.txt

# Local secrets and runtime data
.env
.env.*
.streamlit/secrets.toml
*.db
*.sqlite
*.sqlite3
*.log
*.key
*.pem
*.token
.venv/
venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.DS_Store

# Public Streamlit configuration
!.streamlit/
!.streamlit/config.toml

# Public documents
!docs/
!docs/USAGE_GUIDE.md
!docs/schedule_adjustment_tool_technical_overview.md
!docs/user_guide_assets/
!docs/user_guide_assets/*.png

# Application source
!src/
!src/**/
!src/**/*.py
!src/**/frontend/*.html
